# FastPay Backend Environment

# MongoDB (secured — run npm run mongo:certs before docker:up)
MONGODB_DB_NAME=FastPay
MONGODB_TLS=true
MONGODB_TLS_CA_FILE=infrastructure/mongo/certs/ca.crt
# Dev certs are issued for localhost; allow 127.0.0.1 connections
MONGODB_TLS_ALLOW_INVALID_HOSTNAMES=true
# Leave unset to auto-build from MONGO_APP_* when Docker mongo is on :27018
# MONGODB_URI=mongodb://fastpay_app:change-me-app-dev@127.0.0.1:27018/FastPay?authSource=FastPay

# In-memory Mongo (no Docker secured stack) — shared replica set on :27019 for all services
# npm run mongo:memory              # native mongodb-memory-server, or Docker fallback on Windows
# npm run docker:memory             # Docker-only shared dev DB (no auth/TLS)
# FASTPAY_MEMORY_MONGO=true         # prefer :27019 over secured Docker :27018
# FASTPAY_MEMORY_MONGO=only         # require memory server (fail if :27019 down)
# FASTPAY_MEMORY_MONGO_AUTO_START=false  # do not auto-spawn memory server from services

MONGO_INITDB_ROOT_USERNAME=fastpay_root
MONGO_INITDB_ROOT_PASSWORD=change-me-root-dev
MONGO_APP_USER=fastpay_app
MONGO_APP_PASSWORD=change-me-app-dev
MONGO_BACKUP_USER=fastpay_backup
MONGO_BACKUP_PASSWORD=change-me-backup-dev
MONGO_RO_USER=fastpay_ro
MONGO_RO_PASSWORD=change-me-ro-dev
MONGO_REPLICA_SET=rs0

# Optional Mongo Express UI (npm run docker:tools) — read-only DB user
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me-express-dev

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6380

# RabbitMQ (phase 2 event bus — infra only; BullMQ still handles offline relay)
RABBITMQ_URL=amqp://localhost:5672

# Stellar / mock Horizon
STELLAR_HORIZON_URL=http://localhost:8090
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_FRIENDBOT_URL=http://localhost:8090/friendbot

# Service URLs (local dev)
AUTH_SERVICE_URL=http://localhost:3001
BLOCKCHAIN_SERVICE_URL=http://localhost:3009
PAYMENT_SERVICE_URL=http://localhost:3003
FRAUD_SERVICE_URL=http://localhost:3011
KYC_SERVICE_URL=http://localhost:3012
ASSISTANT_SERVICE_URL=http://localhost:3016
AUDIT_SERVICE_URL=http://localhost:3015

# Assistant / RAG
ASSISTANT_SERVICE_PORT=3016
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai
ASSISTANT_TOP_K=8
ASSISTANT_RATE_LIMIT_PER_HOUR=30
ASSISTANT_FALLBACK_ENABLED=true
ASSISTANT_INDEX_SECRET=dev-index-secret
ASSISTANT_LOCAL_EMBEDDING_DIMS=256

MERCHANT_SERVICE_URL=http://localhost:3006
MERCHANT_SETTLEMENT_PUBLIC_KEY=GCKFBEIYTKPBJRAQDJQHEQUXHPIKUPZOIDFFQPCCVRFHTEYSAVP7SFXM
MERCHANT_SERVICE_PORT=3006
WALLET_SERVICE_URL=http://localhost:3002
INTERNAL_SERVICE_SECRET=dev-internal-secret-change-in-production
FASTPAY_INLINE_OFFLINE_QUEUE=true
AUDIT_SERVICE_URL=http://localhost:3015

# Fraud provider: mock | http
CHAINALYSIS_PROVIDER=mock
CHAINALYSIS_MOCK_URL=http://localhost:3011/compliance/chainalysis
CHAINALYSIS_HTTP_URL=
CHAINALYSIS_API_KEY=mock-api-key

# Offline relay
OFFLINE_QUEUE_NAME=offline-tx
OFFLINE_ESTIMATED_SECONDS=120
OFFLINE_RETRY_ATTEMPTS=5
OFFLINE_RETRY_BACKOFF_MS=5000

# JWT (auth-service)
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_LOCKOUT_SECONDS=900
AUTH_REGISTER_MAX_PER_IP=10
AUTH_REGISTER_WINDOW_SECONDS=3600

# Ports (each service uses its own *_SERVICE_PORT — do not rely on PORT=3000)
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
PAYMENT_SERVICE_PORT=3003
BLOCKCHAIN_SERVICE_PORT=3009
FRAUD_SERVICE_PORT=3011
KYC_SERVICE_PORT=3012
